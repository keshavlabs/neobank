      "config": {
        "version": "1.1",
        "source": "SELECT\r\n  branch_name,\r\n  total_customers,\r\n  total_accounts,\r\n  total_deposits,\r\n  total_transaction_amount,\r\n  total_transactions\r\nFROM\r\n  neobank.gold.branch_performance",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "363fcc13",
      "displayName": "gateway_status",
      "config": {
        "version": "1.1",
        "source": "SELECT gateway_name,\r\n       SUM(successful_transactions) AS successful,\r\n       SUM(failed_transactions) AS failed,\r\n       SUM(pending_transactions) AS pending\r\nFROM neobank.gold.transaction_channel_summary\r\nGROUP BY gateway_name",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "16fd1d38",
      "displayName": "device_usage",
      "config": {
        "version": "1.1",
        "source": "SELECT device_type, SUM(total_transactions) AS transactions\r\nFROM neobank.gold.transaction_channel_summary\r\nGROUP BY device_type",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "ac191235",
      "displayName": "daily_trend",
      "config": {
        "version": "1.1",
